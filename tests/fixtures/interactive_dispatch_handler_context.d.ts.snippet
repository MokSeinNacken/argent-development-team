  callback: {
    data: string;
    namespace: string;
    payload: string;
    messageId: number;
    chatId: string;
    messageText?: string;
  };
  respond: {
    reply: (params: {
      text: string;
      buttons?: TelegramInteractiveButtons;
    }) => Promise<void>;
    editMessage: (params: {
      text: string;
      buttons?: TelegramInteractiveButtons;
    }) => Promise<void>;
    editButtons: (params: {
      buttons: TelegramInteractiveButtons;
    }) => Promise<void>;
    clearButtons: () => Promise<void>;
    deleteMessage: () => Promise<void>;
  };
  requestConversationBinding: (params?: PluginConversationBindingRequestParams) => Promise<PluginConversationBindingRequestResult>;
